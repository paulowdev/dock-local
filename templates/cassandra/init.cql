-- Generated by dock-local: keyspaces referenced by the project (idempotent).
CREATE KEYSPACE IF NOT EXISTS {{env.CASSANDRA_KEYSPACE}} WITH replication = {'class': 'SimpleStrategy', 'replication_factor': 1};
{{#each resources.keyspaces}}
CREATE KEYSPACE IF NOT EXISTS {{this}} WITH replication = {'class': 'SimpleStrategy', 'replication_factor': 1};
{{/each}}
