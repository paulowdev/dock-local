{
  "realm": "{{env.KEYCLOAK_REALM}}",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "accessTokenLifespan": 3600,
  "roles": {
    "realm": [
      { "name": "user", "description": "Default application user" },
      { "name": "admin", "description": "Application administrator" }
    ]
  },
  "users": [
    {
      "username": "dev",
      "enabled": true,
      "email": "dev@local.test",
      "firstName": "Dev",
      "lastName": "User",
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "dev", "temporary": false }],
      "realmRoles": ["user", "admin"]
    }
  ],
  "clients": [
    {
      "clientId": "{{env.KEYCLOAK_CLIENT_ID}}",
      "name": "Application client (generated by dock-local)",
      "enabled": true,
      "publicClient": false,
      "secret": "{{env.KEYCLOAK_CLIENT_SECRET}}",
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": true,
      "redirectUris": ["http://localhost:*", "http://127.0.0.1:*"],
      "webOrigins": ["*"],
      "protocol": "openid-connect",
      "defaultClientScopes": ["profile", "email", "roles", "web-origins"]
    }{{#each resources.oauth_clients}},
    {
      "clientId": "{{this}}",
      "enabled": true,
      "publicClient": false,
      "secret": "{{env.KEYCLOAK_CLIENT_SECRET}}",
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": true,
      "redirectUris": ["http://localhost:*"],
      "webOrigins": ["*"],
      "protocol": "openid-connect"
    }{{/each}}
  ]
}
