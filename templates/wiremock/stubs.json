{
  "mappings": [
    {
      "name": "dock health",
      "priority": 1,
      "request": { "method": "GET", "url": "/__dock/health" },
      "response": { "status": 200, "jsonBody": { "status": "UP", "by": "dock-local" } }
    }{{#each resources.hosts}},
    {
      "name": "stub for {{this}}",
      "priority": 10,
      "request": {
        "method": "ANY",
        "urlPathPattern": "/.*",
        "headers": { "Host": { "contains": "{{this}}" } }
      },
      "response": {
        "status": 200,
        "headers": { "Content-Type": "application/json" },
        "jsonBody": { "stub": "{{this}}", "path": "{{{request.path}}}", "message": "Replace this placeholder with a realistic response" }
      }
    }{{/each}},
    {
      "name": "catch-all",
      "priority": 100,
      "request": { "method": "ANY", "urlPathPattern": "/.*" },
      "response": {
        "status": 200,
        "headers": { "Content-Type": "application/json" },
        "jsonBody": { "stub": "catch-all", "path": "{{{request.path}}}", "message": "Add a specific mapping in .dock/init/wiremock/mappings" }
      }
    }
  ]
}
